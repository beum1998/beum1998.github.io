{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://github.com/junghunlee/augmentedBimLogSchema/augmentedBimTLog.v4r1.schema.json",
  "title": "Augmented BIM Log Schema",
  "description": "A time-series log of BIM design changes in shape and quantity.",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "projectName": {
      "type": "string"
    },
    "guid": {
      "type": "string"
    },
    "startTime": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{2}-\\d{2}-\\d{2}$",
      "description": "Timestamp in YYYY-MM-DD-HH-MM-SS format"
    },
    "endTime": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{2}-\\d{2}-\\d{2}$",
      "description": "Timestamp in YYYY-MM-DD-HH-MM-SS format"
    },
    "saved": {
      "type": "boolean"
    },
    "timeLog": {
      "type": "object",
      "description": "Dictionary keyed by timestamp (YYYY-MM-DD-HH-MM-SS). Each timestamp maps to elementVersionList and quantityLog.",
      "patternProperties": {
        "^\\d{4}-\\d{2}-\\d{2}-\\d{2}-\\d{2}-\\d{2}$": {
          "type": "object",
          "properties": {
            "elementVersionList": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "elementVersion": {
                    "type": "string",
                    "description": "A unique element version identifier at the event time in the form of elementID_version"
                  }
                },
                "required": ["elementVersion"],
                "additionalProperties": false
              }
            },
            "quantityLog": {
              "type": "array",
              "description": "Array of BIM elements with their properties at this save point",
              "items": {
                "type": "object",
                "properties": {
                  "elementCategory": {
                    "type": "string",
                    "description": "The element category such as walls and columns"
                  },
                  "takeOff": {
                    "type": "array",
                    "description": "Custom properties for this element",
                    "items": {
                      "type": "object",
                      "properties": {
                        "takeOffItem": {
                          "type": "string"
                        },
                        "takeOffQuantity": {
                          "oneOf": [
                            { "type": "string" },
                            { "type": "number" },
                            { "type": "integer" }
                          ]
                        }
                      },
                      "required": ["takeOffItem", "takeOffQuantity"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["elementCategory"],
                "additionalProperties": false
              }
            }
          },
          "required": ["elementVersionList", "quantityLog"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "shapeLog": {
      "type": "array",
      "description": "Array of attribute and geometric information",
      "items": {
        "type": "object",
        "properties": {
          "elementId": {
            "type": "string"
          },
          "commandType": {
            "type": "string",
            "description": "The command type - C: created, M: modified, D: deleted",
            "enum": ["C", "M", "D"]
          },
          "common": {
            "type": "object",
            "properties": {
              "elementId": {
                "type": "string"
              },
              "elementVersion": {
                "type": "string"
              },
              "elementCategory": {
                "type": "string",
                "description": "The element category such as walls or columns"
              },
              "elementFamily": {
                "type": "string"
              }
            }
          },
          "placement": {
            "type": "object",
            "description": "Placement information of the element",
            "properties": {
              "basePoint": {
                "type": "array",
                "description": "XYZ values",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "basePlane": {
                "type": "string",
                "description": "The level, floor, or plane that the element is placed on"
              },
              "hostReference": {
                "type": "string",
                "description": "A host element that an element is nested within (e.g., a window in a wall)"
              },
              "orientation": {
                "type": "array",
                "description": "Direction vector defining the placement/facing direction (XYZ unit vector)",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "materialLayers": {
            "type": "array",
            "description": "Array of material layers of each element",
            "items": {
              "type": "object",
              "properties": {
                "materialName": {
                  "type": "string"
                },
                "function": {
                  "type": "string"
                },
                "materialQuantity": {
                  "type": "number"
                }
              }
            }
          },
          "parameters": {
            "type": "array",
            "description": "Array of element parameters",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "storageType": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                },
                "valueString": {
                  "type": "string"
                }
              }
            }
          },
          "meshArray": {
            "type": "array",
            "description": "Array of meshes that defines an element shape",
            "items": {
              "type": "object",
              "properties": {
                "material": {
                  "type": "string"
                },
                "color": {
                  "type": "array",
                  "description": "RGB colors",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "integer"
                  }
                },
                "opacity": {
                  "type": "integer"
                },
                "vertices": {
                  "type": "array",
                  "description": "Flattened XYZ values",
                  "items": {
                    "type": "number"
                  }
                },
                "indices": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": ["userId", "projectName", "guid", "timeLog"],
  "additionalProperties": false
}